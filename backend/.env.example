PORT=3000
JWT_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-deploy
# Bật AI: anthropic | openai | gemini | ollama | offline (mặc định offline)
AI_PROVIDER=offline
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434
AI_TIMEOUT_MS=20000
# Biến thể prompt: v1_basic | v2_schema | v3_final
PROMPT_VARIANT=v3_final
# DB_FILE=./data/app.db
# Bảo mật
# true: thay tên thành viên bằng "Thành viên 1, 2..." trước khi gửi cho AI
AI_ANONYMIZE=false
# Số ngày giữ nhật ký AI, quá hạn sẽ bị xóa khi khởi động
AI_LOG_RETENTION_DAYS=30
# Đặt 1 khi chạy sau proxy như Render, để giới hạn tốc độ tính đúng theo IP người dùng
TRUST_PROXY=0